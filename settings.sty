\RequirePackage{pgffor}
\newcommand{\mynames}[1]{\def\my@namelist{#1}}
\newtoggle{boldname}
% Student co-author markers: driven by AUTHOR+an = {<n>=gradstudent} or
% {<n>=ugstudent} data annotations in the .bib files (positions are 1-based
% author indices). Off by default; enable per document with
% \toggletrue{studentmarkers} (see cv-latex front matter handling).
% Renders \textdagger for graduate and \textdaggerdbl for undergraduate
% student co-authors.
\newtoggle{studentmarkers}
\newcommand{\applymynamestyles}{%
  \renewcommand*{\mkbibnamefamily}[1]{%
    \global\togglefalse{boldname}%
    \foreach \my@fname / \my@gname in \my@namelist {%
      \ifboolexpr{ test {\ifdefstrequal{\namepartfamily}{\my@fname}}
                   and
                   test {\ifdefstrequal{\namepartgiven}{\my@gname}}}
        {\global\toggletrue{boldname}}{}%
    }%
    \iftoggle{boldname}{\textbf{##1}}{##1}%
    \iftoggle{studentmarkers}{%
      \ifitemannotation{gradstudent}{\textsuperscript{\textdagger}}{}%
      \ifitemannotation{ugstudent}{\textsuperscript{\textdaggerdbl}}{}%
    }{}%
  }%
  \renewcommand*{\mkbibnamegiven}[1]{%
    \global\togglefalse{boldname}%
    \foreach \my@fname / \my@gname in \my@namelist{%
      \ifboolexpr{ test {\ifdefstrequal{\namepartfamily}{\my@fname}}
                   and
                   test {\ifdefstrequal{\namepartgiven}{\my@gname}}}
        {\global\toggletrue{boldname}\breakforeach}{}%
    }%
    \iftoggle{boldname}{\textbf{##1}}{##1}%
  }%
  \renewcommand*{\mkbibnamesuffix}[1]{%
    \iftoggle{boldname}{\textbf{##1}}{##1}%
  }%
}

\applymynamestyles
\AtBeginDocument{\applymynamestyles}


