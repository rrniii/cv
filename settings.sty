% Numbered entries without the prefix marker (e.g., grants, students).
\newcounter{numentry}
\newcommand{\resetnumentry}{\setcounter{numentry}{0}}
\newcommand{\numkey}[1]{\stepcounter{numentry}\thenumentry.~#1}
\newenvironment{numberedrubric}[1]{%
  \resetnumentry
  \let\saved@prefix\@prefix
  \def\@prefix{}%
  \begin{rubric}{#1}
}{%
  \end{rubric}
  \let\@prefix\saved@prefix
}

% Enumerated entries with explicit numbering (e.g., students, talks).
\newenvironment{enumeratedrubric}[1]{%
  \let\saved@prefix\@prefix
  \def\@prefix{}%
  \begin{rubric}{#1}
}{%
  \end{rubric}
  \let\@prefix\saved@prefix
}

% Grants rubric with number, date, description, and amount columns.
\newcommand{\grantentry}[4]{#1 & #2 & #3 & #4\\}
\newlength{\grantnumwidth}
\newlength{\grantdatewidth}
\newlength{\grantamountwidth}
\newlength{\grantdescwidth}
\newlength{\grantgapA}
\newlength{\grantgapB}
\newlength{\grantgapC}
\setlength{\grantnumwidth}{2.2em}
\setlength{\grantdatewidth}{3.2cm}
\setlength{\grantamountwidth}{3.0cm}
\setlength{\grantgapA}{0.6em}
\setlength{\grantgapB}{0.9em}
\setlength{\grantgapC}{0.9em}
\setlength{\grantdescwidth}{\dimexpr\textwidth-\grantnumwidth-\grantdatewidth-\grantamountwidth-\grantgapA-\grantgapB-\grantgapC\relax}
\newenvironment{grantrubric}[1]{%
  \def\raggedright{%
    \@rightskip\@flushglue\rightskip\@rightskip\leftskip\z@skip}%
  \def\raggedleft{%
    \rightskip\z@skip\leftskip\@flushglue\parfillskip\z@skip}%
  \setlength{\LTleft}{0pt}%
  \setlength{\LTright}{0pt}%
  \setlength{\tabcolsep}{0pt}%
  % Date column: ragged-right and unhyphenated so month ranges wrap cleanly
  % ("September 2024 -- December 2026") instead of being justified or broken
  % mid-word ("De-cember").
  \begin{longtable}{@{}p{\grantnumwidth}@{\hspace{\grantgapA}}>{\raggedright\arraybackslash\hyphenpenalty=10000\exhyphenpenalty=10000}p{\grantdatewidth}@{\hspace{\grantgapB}}p{\grantdescwidth}@{\hspace{\grantgapC}}>{\raggedleft\arraybackslash}p{\grantamountwidth}@{}}
    \multicolumn{4}{@{}l@{}}{\@@rubrichead{#1}}\\*[\rubricspace]
    \endfirsthead
    \multicolumn{4}{@{}l@{}}{\@@rubrichead{#1\@continuedname}}\\*[\rubricspace]
    \endhead
}{%
  \end{longtable}\par\vspace\rubricafterspace
}

