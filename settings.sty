% ---------------------------------------------------------------------------
% Per-document section heading control, driven by a .qmd's "cv-sections"
% front matter (see filters/cv_templates.lua). Documents without it get the
% original headings unchanged.
%
%   \CVretitle{Generated Title}{Display Title}
%       Show a section under a different heading. The generated .tex files
%       bake in each section's source title, so the swap happens at
%       typesetting time and covers the "(continued)" running head too.
%   \CVdemoted{<rubric command>}
%       Typeset the rubric's head in the subordinate "group" style, so the
%       section reads as part of the category heading that precedes it.
% ---------------------------------------------------------------------------
\newif\ifcv@demote
\let\cv@stop\relax
\newcommand\CVretitle[2]{\expandafter\gdef\csname cv@retitle@#1\endcsname{#2}}
\newcommand\CVdemoted[1]{\begingroup\cv@demotetrue#1\endgroup}

% Split "Title" or "Title\@continuedname" into the base title and the suffix,
% then apply any \CVretitle mapping to the base.
\def\cv@splitcont#1\@continuedname#2\cv@stop{%
  \def\cv@basetitle{#1}\def\cv@contpart{#2}}
\def\cv@resolvetitle#1{%
  \cv@splitcont#1\@continuedname\cv@stop
  \ifcsname cv@retitle@\cv@basetitle\endcsname
    \csname cv@retitle@\cv@basetitle\endcsname
  \else
    \cv@basetitle
  \fi
  \ifx\cv@contpart\@empty\else\@continuedname\fi}

% Category heading: full-width swish rule, rubric font.
\def\cv@rubrichead@category#1{%
  \begin{tikzpicture}[baseline]%
  \shade[left color=SwishLineColour!60!white, right color=white] rectangle (\@almosttextwidth,2.5pt);
  \node[font={\@rubricfont},inner sep=0pt,text ragged,anchor=south west,text depth=.5ex,text height=1.5ex] at (1pt,2pt) {\cv@resolvetitle{#1}};
  \end{tikzpicture}%
  \vspace\rubricspace%
}
% Group heading (demoted section): shorter, lighter rule, subrubric font.
\def\cv@rubrichead@group#1{%
  \begin{tikzpicture}[baseline]%
  \shade[left color=SwishLineColour!35!white, right color=white] rectangle (0.45\@almosttextwidth,1.5pt);
  \node[font={\@subrubricfont},inner sep=0pt,text ragged,anchor=south west,text depth=.5ex,text height=1.5ex] at (1pt,2pt) {\cv@resolvetitle{#1}};
  \end{tikzpicture}%
  \vspace\rubricspace%
}
\def\@@rubrichead{%
  \ifcv@demote\expandafter\cv@rubrichead@group\else\expandafter\cv@rubrichead@category\fi}

\subrubricfont{\large\bfseries\sffamily}
